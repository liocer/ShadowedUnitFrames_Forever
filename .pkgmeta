# BigWigs packager config. The repo holds two addons, each in its own folder:
#   ShadowedUnitFrames_Forever/  the addon
#   ShadowedUF_Forever_Options/  its load-on-demand options
# Both are moved to the top of the zip; everything else (tools, docs) is left out.
# Libraries are committed under each addon's libs/ folder, so there are no externals.
package-as: ShadowedUnitFrames_Forever

move-folders:
  ShadowedUnitFrames_Forever/ShadowedUnitFrames_Forever: ShadowedUnitFrames_Forever
  ShadowedUnitFrames_Forever/ShadowedUF_Forever_Options: ShadowedUF_Forever_Options

ignore:
  - .editorconfig
  - .luacheckrc
  - locale-import.lua
  - tools
  - README.md
